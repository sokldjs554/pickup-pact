{
  "components": {
    "schemas": {
      "Command": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "reserve",
              "transfer",
              "disrupt",
              "delay",
              "advance",
              "start",
              "ready",
              "claim",
              "cancel",
              "recover",
              "reorder"
            ],
            "title": "Action"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "request_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$",
            "title": "Request Id"
          },
          "quote_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Quote Id"
          },
          "store_id": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "corner",
                  "wave",
                  "oat",
                  "garden",
                  "express"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Store Id"
          },
          "minutes": {
            "type": "integer",
            "maximum": 30.0,
            "minimum": 0.0,
            "title": "Minutes",
            "default": 0
          },
          "pickup_code": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 12
              },
              {
                "type": "null"
              }
            ],
            "title": "Pickup Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "expected_version",
          "request_id"
        ],
        "title": "Command"
      },
      "ExperimentRequest": {
        "properties": {
          "seed": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Seed",
            "default": 7
          },
          "cases": {
            "type": "integer",
            "maximum": 200.0,
            "minimum": 6.0,
            "title": "Cases",
            "default": 120
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ExperimentRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Intent": {
        "properties": {
          "destination": {
            "type": "string",
            "enum": [
              "office",
              "park"
            ],
            "title": "Destination",
            "default": "office"
          },
          "deadline_minutes": {
            "type": "integer",
            "maximum": 90.0,
            "minimum": 3.0,
            "title": "Deadline Minutes",
            "default": 16
          },
          "drink": {
            "type": "string",
            "enum": [
              "americano",
              "latte"
            ],
            "title": "Drink",
            "default": "latte"
          },
          "milk": {
            "type": "string",
            "enum": [
              "regular",
              "oat"
            ],
            "title": "Milk",
            "default": "regular"
          },
          "decaf": {
            "type": "boolean",
            "title": "Decaf",
            "default": false
          },
          "budget": {
            "type": "integer",
            "maximum": 30000.0,
            "minimum": 1000.0,
            "title": "Budget",
            "default": 5500
          },
          "max_detour": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 0.0,
            "title": "Max Detour",
            "default": 5
          },
          "priority": {
            "type": "string",
            "enum": [
              "arrival",
              "price",
              "walk"
            ],
            "title": "Priority",
            "default": "arrival"
          },
          "coupon_id": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "welcome500",
                  "wave1000",
                  "morning10"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Coupon Id"
          },
          "points": {
            "type": "integer",
            "maximum": 2000.0,
            "minimum": 0.0,
            "title": "Points",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Intent"
      },
      "TransferComparisonRequest": {
        "properties": {
          "intent": {
            "$ref": "#/components/schemas/Intent"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "TransferComparisonRequest"
      },
      "TransferControl": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "fault",
              "occupy",
              "clear"
            ],
            "title": "Action"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "request_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$",
            "title": "Request Id"
          },
          "fault": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "none",
                  "target_reject",
                  "after_target_hold",
                  "after_source_release",
                  "after_target_activation"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Fault"
          },
          "store_id": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "corner",
                  "wave",
                  "oat",
                  "garden",
                  "express"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Store Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "expected_version",
          "request_id"
        ],
        "title": "TransferControl"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
