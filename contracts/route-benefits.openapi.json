{
  "components": {
    "schemas": {
      "Command": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "reserve",
              "transfer",
              "disrupt",
              "delay",
              "advance",
              "start",
              "ready",
              "claim",
              "cancel",
              "recover",
              "reorder"
            ],
            "title": "Action",
            "type": "string"
          },
          "expected_version": {
            "minimum": 1.0,
            "title": "Expected Version",
            "type": "integer"
          },
          "minutes": {
            "default": 0,
            "maximum": 30.0,
            "minimum": 0.0,
            "title": "Minutes",
            "type": "integer"
          },
          "pickup_code": {
            "anyOf": [
              {
                "maxLength": 12,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pickup Code"
          },
          "quote_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quote Id"
          },
          "request_id": {
            "pattern": "^[a-zA-Z0-9_-]{1,80}$",
            "title": "Request Id",
            "type": "string"
          },
          "store_id": {
            "anyOf": [
              {
                "enum": [
                  "corner",
                  "wave",
                  "oat",
                  "garden",
                  "express"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Store Id"
          }
        },
        "required": [
          "action",
          "expected_version",
          "request_id"
        ],
        "title": "Command",
        "type": "object"
      },
