[Unit]
Description=Pickup Pact synthetic merchant role (ha_postgres_v1, order role only)
After=network-online.target
Wants=network-online.target

[Service]
User=pickup
Group=pickup
WorkingDirectory=/opt/pickup-pact
EnvironmentFile=/etc/pickup-pact/pickup-merchant.env
EnvironmentFile=/etc/pickup-pact/secrets/merchant.env
ExecStart=/opt/pickup-pact/.venv/bin/python -m demo.route.ha.merchant_service --port ${PICKUP_MERCHANT_PORT}
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
