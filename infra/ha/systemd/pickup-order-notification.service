[Unit]
Description=Pickup Pact payment notification receiver (ha_postgres_v1, payment role only)
After=network-online.target
Wants=network-online.target

[Service]
User=pickup
Group=pickup
WorkingDirectory=/opt/pickup-pact
EnvironmentFile=/etc/pickup-pact/pickup-order.env
EnvironmentFile=/etc/pickup-pact/secrets/order.env
ExecStart=/opt/pickup-pact/.venv/bin/python -m demo.route.ha.notification_service --port ${PICKUP_NOTIFICATION_PORT}
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
